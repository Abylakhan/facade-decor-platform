# --- Server-side only (never prefix secrets with NEXT_PUBLIC_) ---
# demo | crm. Chooses catalog/pricing providers at build/server time. Not switchable from the UI.
DATA_SOURCE=demo
# Required only when DATA_SOURCE=crm (adapter is not implemented until CRM access is granted)
CRM_BASE_URL=
CRM_API_TOKEN=

# --- Public, non-secret ---
# Deployment sub-path, e.g. /facade-decor-platform for GitHub Pages project sites
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Company WhatsApp number in international format without "+", e.g. 77010000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
